# ===== Telegram =====
# @BotFather dan olingan token
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bot username (@ belgisiz)
BOT_USERNAME=mening_botim
# Admin ID lar, vergul bilan. O'z ID'ingizni botdagi /id buyrug'i bilan biling
ADMIN_IDS=123456789

# ===== Server (Render) =====
PORT=3000
# Render bergan manzil. Lokalda bo'sh qoldiring -> polling rejimi ishlaydi
PUBLIC_URL=
# Webhook yo'li uchun maxfiy so'z (faqat harf/raqam/_/-)
WEBHOOK_SECRET=super_maxfiy_kalit_123

# ===== Ma'lumotlar bazasi =====
# Render PostgreSQL "Internal Database URL". Bo'sh bo'lsa -> lokal JSON fayl
DATABASE_URL=
JSON_DB_PATH=./data/db.json

# ===== Biznes sozlamalari =====
CURRENCY=so'm
MIN_TOPUP=5000
MIN_ORDER_QUANTITY=100

# Referal: 1 ta taklif qilingan foydalanuvchi uchun beriladigan summa
REFERRAL_BONUS=100
# Qo'shimcha: referal hisobini to'ldirganda ham foiz bonus (0 = o'chirilgan)
REFERRAL_PERCENT=0

# Bepul xizmatlar: bir foydalanuvchi kuniga nechta bepul buyurtma bera oladi
FREE_DAILY_LIMIT=1

# To'lov rekvizitlari
CARD_NUMBER=8600 1234 5678 9012
CARD_HOLDER=ALISHER VALIYEV

SUPPORT_USERNAME=admin
CHANNEL_URL=

# Majburiy obuna: bo'sh bo'lsa CHANNEL_URL ishlatiladi, u ham bo'sh bo'lsa - tekshiruv o'chirilgan.
# @kanal_username, -100xxxxxxxxxx (chat id) yoki https://t.me/kanal_username shaklida.
# DIQQAT: bot shu kanalda ADMIN bo'lishi shart, aks holda a'zolikni tekshira olmaydi
# (bunday holda hech kimni bloklamay, botdan foydalanishga ruxsat beradi).
REQUIRED_CHANNEL=

# ===== SMM provayder (ixtiyoriy) =====
# Masalan, TopSMM: https://topsmm.uz/account sahifasidan API kalitni oling.
# Bo'sh qoldirsangiz buyurtmalar qo'lda bajariladi
SMM_API_URL=https://topsmm.uz/api/v2
SMM_API_KEY=

# ===== Redis (unikal summa orqali avtomatik to'lovni aniqlash) =====
# Lokal: `docker compose up -d redis` keyin -> redis://localhost:6379
# docker-compose ichida bot ham konteynerda bo'lsa -> redis://redis:6379
REDIS_URL=redis://localhost:6379

# /webhook/payment ni himoyalovchi maxfiy token (o'zingiznikini qo'ying!)
PAYMENT_WEBHOOK_SECRET=payment-webhook-secret

# Unikal summa nechi soniya "band" turishi (standart 900 = 15 daqiqa)
UNIQUE_AMOUNT_TTL_SEC=900
# Asosiy summaga qo'shiladigan tasodifiy suffiksning maksimal qiymati (1-99)
UNIQUE_AMOUNT_SUFFIX_MAX=99

# ===== Hamkorlik = sizning API'ingiz =====
# Bo'sh qoldiring — PUBLIC_URL asosida avtomatik yasaladi:
# https://domen.com/BOT_USERNAME/api/v2
API_BASE_URL=
